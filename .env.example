# ─────────────────────────────────────────────
#  PulseOS — Environment Variables
#  Copy this to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pulseos:pulseos@db:5432/pulseos
# For local dev without Docker:
# DATABASE_URL=postgresql+asyncpg://pulseos:pulseos@localhost:5432/pulseos

# ── Security ──────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme-use-openssl-rand-hex-32-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM (Groq) ────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── File Storage ──────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Email (console logger in dev) ─────────────
MAIL_BACKEND=console
# For real SMTP, set MAIL_BACKEND=smtp and fill these:
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_your_key_here
# MAIL_FROM=noreply@yourdomain.com

# ── App ───────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
